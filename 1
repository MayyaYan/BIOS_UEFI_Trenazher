 <div class="bbody"><div class="bleft">${B.sub?`<div class="row h">▼ ${esc(BSUB[B.sub].t)}</div>`:''}${rows}</div><div class="bright">${esc(cur.h||'')}${B.sub?'<br><br>Esc — назад':''}</div></div>
