<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Тренажёр «Параметры BIOS и UEFI»</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f3f5fa;--panel:#fff;--ink:#1d2333;--muted:#5d667a;--line:#e1e5ee;--acc:#4f46e5;--acc2:#0d9488;--acc3:#d97706;--acc4:#e11d48;--soft:#eef0ff;--soft2:#e3f5f2;--soft3:#fdf2e2;--soft4:#fde7eb;--ok:#16a34a;--bad:#e11d48;--shadow:0 10px 30px rgba(29,35,51,.07)}
[data-theme=dark]{--bg:#0e1320;--panel:#161d2d;--ink:#e6eaf4;--muted:#9aa3b9;--line:#283147;--soft:#23264a;--soft2:#12312d;--soft3:#3a2b13;--soft4:#3e1a24;--shadow:none}
html,body{height:100%}
body{font-family:"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--ink);display:flex;flex-direction:column;overflow:hidden;font-size:22pt}
header{height:60px;display:flex;align-items:center;gap:12px;padding:0 16px;background:var(--panel);border-bottom:1px solid var(--line);flex-shrink:0}
.brand{display:flex;align-items:center;gap:10px;font-weight:700}
.logo{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#e11d48,#d97706);display:grid;place-items:center;color:#fff;font-size:26pt}
.sp{flex:1}
.who{font-size:22pt;color:var(--muted);text-align:right;line-height:1.3}
.pill{padding:7px 12px;border-radius:999px;font-weight:700;font-size:22pt;background:var(--soft);color:var(--acc);white-space:nowrap}
.timer{font-family:Consolas,Menlo,monospace;font-size:22pt;background:#1f2636;color:#a7f3d0;padding:7px 12px;border-radius:10px;min-width:92px;text-align:center}
.timer.warn{background:#d97706;color:#fff}.timer.crit{background:#e11d48;color:#fff;animation:bl 1s infinite}
@keyframes bl{50%{opacity:.6}}
.hbtn{border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:7px 10px;border-radius:10px;cursor:pointer;font:inherit}
.wrap{flex:1;display:grid;grid-template-columns:260px 1fr;min-height:0}
aside{background:var(--panel);border-right:1px solid var(--line);overflow:auto;padding:14px 10px}
.st{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;background:none;color:var(--ink);padding:10px;border-radius:12px;cursor:pointer;font:inherit;margin-bottom:4px}
.st:hover:not(:disabled){background:var(--bg)}.st.on{background:var(--soft)}.st:disabled{opacity:.45;cursor:not-allowed}
.st .n{width:32px;height:32px;border-radius:10px;background:var(--bg);border:1px solid var(--line);display:grid;place-items:center;font-weight:700;flex-shrink:0}
.st.on .n{background:var(--acc);color:#fff;border-color:var(--acc)}.st.done .n{background:var(--ok);color:#fff;border-color:var(--ok)}
.st small{display:block;color:var(--muted);font-size:22pt}
.st b{font-size:22pt;font-weight:600}
.plan{margin-top:14px;padding:12px;border-radius:12px;background:var(--bg);font-size:22pt;color:var(--muted);line-height:1.5}
main{overflow:auto;padding:22px 18px 40px}
.card{max-width:1120px;margin:0 auto 18px;background:var(--panel);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);padding:24px 28px}
.kicker{font-size:22pt;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);font-weight:700;margin-bottom:6px}
h1{font-size:34pt;margin-bottom:12px;line-height:1.2}h2{font-size:26pt;margin:6px 0 10px}h3{font-size:22pt;margin:12px 0 6px}
p{line-height:1.6;margin-bottom:8px}
.task{background:var(--soft);border-left:4px solid var(--acc);border-radius:12px;padding:12px 16px;margin:10px 0 16px;line-height:1.6}
.hint{background:var(--soft3);border-left:4px solid var(--acc3);border-radius:12px;padding:10px 14px;margin:10px 0;font-size:22pt;line-height:1.55}
ul.l{list-style:none;margin:6px 0}ul.l li{padding-left:20px;position:relative;margin:6px 0;line-height:1.5}ul.l li:before{content:"";position:absolute;left:3px;top:8px;width:8px;height:8px;border-radius:3px;background:var(--acc)}
.btn{border:0;background:var(--acc);color:#fff;padding:11px 18px;border-radius:12px;font:inherit;font-weight:600;cursor:pointer}
.btn:hover:not(:disabled){filter:brightness(1.1)}.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.g{background:var(--acc2)}.btn.o{background:transparent;color:var(--acc);border:1px solid var(--acc)}.btn.r{background:var(--acc4)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:14px}
.res{padding:10px 14px;border-radius:12px;font-weight:600;display:inline-block}
.res.ok{background:#dcfce7;color:#166534}.res.mid{background:#fef3c7;color:#92400e}.res.bad{background:#ffe4e6;color:#9f1239}
[data-theme=dark] .res.ok{background:#14532d;color:#bbf7d0}[data-theme=dark] .res.mid{background:#78350f;color:#fde68a}[data-theme=dark] .res.bad{background:#881337;color:#fecdd3}
input[type=text],input[type=number],select{padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:inherit}
input.okf{border-color:var(--ok);background:#dcfce7;color:#166534}input.badf{border-color:var(--bad);background:#ffe4e6;color:#9f1239}
table{border-collapse:collapse;width:100%}
.tw{overflow-x:auto}
.cls th,.cls td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
.cls th{font-size:22pt;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.os{display:flex;align-items:center;gap:10px;min-width:180px}.os svg{flex-shrink:0}.os small{display:block;color:var(--muted);font-size:22pt}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--bg)}
.seg button{border:0;background:none;color:var(--ink);padding:8px 9px;font:inherit;font-size:22pt;cursor:pointer;white-space:nowrap}
.seg button+button{border-left:1px solid var(--line)}
.seg button.on{background:var(--acc);color:#fff}
.seg.ok{outline:2px solid var(--ok)}.seg.bad{outline:2px solid var(--bad)}
.seg button.right{box-shadow:inset 0 -3px 0 var(--ok)}
.expl td{background:var(--bg);font-size:22pt;color:var(--muted);padding:8px 12px}
.ptable td,.ptable th{border:1px solid var(--line);padding:8px 12px;text-align:center}.ptable th{background:var(--soft)}
.brushes{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0}
.brush{width:46px;height:42px;border-radius:10px;border:2px solid transparent;color:#fff;font-weight:800;font-size:22pt;cursor:pointer}
.brush.on{border-color:var(--ink);transform:scale(1.08)}
.pA{background:#4f46e5!important;color:#fff}.pB{background:#0d9488!important;color:#fff}.pC{background:#d97706!important;color:#fff}
.gantt{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;margin-top:6px;user-select:none;touch-action:none}
.cell{height:46px;border-radius:8px;background:var(--bg);border:1px dashed var(--line);display:grid;place-items:center;font-weight:800;cursor:pointer;font-size:22pt;position:relative}
.cell:hover{border-color:var(--acc)}
.cell.ok:after,.cell.bad:after{position:absolute;top:-7px;right:-5px;width:16px;height:16px;border-radius:50%;font-size:22pt;display:grid;place-items:center;color:#fff}
.cell.ok:after{content:"✓";background:var(--ok)}.cell.bad:after{content:"✗";background:var(--bad)}
.axis{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;font-size:22pt;color:var(--muted);margin-top:3px;position:relative}
.axis span{transform:translateX(-50%);width:max-content}.axis .end{position:absolute;right:0;transform:translateX(50%)}
.cnts{display:flex;gap:10px;font-size:22pt;margin-top:6px;flex-wrap:wrap}.cnts span{padding:3px 9px;border-radius:999px;background:var(--bg)}
.cnts .full{background:#dcfce7;color:#166534}.cnts .over{background:#ffe4e6;color:#9f1239}
.gbox{border:1px solid var(--line);border-radius:14px;padding:14px;margin:12px 0}
.correct .cell{animation:pop .35s both;cursor:default;border-style:solid}
@keyframes pop{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:none}}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.term{background:#0b111c;border-radius:14px;padding:14px;font-family:Consolas,Menlo,"Courier New",monospace;font-size:22pt;color:#d1fae5;height:470px;overflow:auto;cursor:text;line-height:1.5}
.term pre{white-space:pre-wrap;word-break:break-word;font:inherit;margin:0}
.term .pr{color:#86efac;font-weight:700}.term .er{color:#fca5a5}.term .inf{color:#93c5fd}
.term .il{display:flex;gap:8px}.term input{flex:1;background:none;border:0;outline:0;color:#fff;font:inherit;padding:0}
.obj{display:flex;gap:10px;padding:9px 10px;border-radius:10px;margin:5px 0;background:var(--bg);font-size:22pt;line-height:1.4;align-items:flex-start}
.obj i{font-style:normal;width:22px;height:22px;border-radius:50%;border:2px solid var(--line);flex-shrink:0;display:grid;place-items:center;font-size:22pt}
.obj.done{background:#dcfce7;color:#166534}.obj.done i{background:var(--ok);border-color:var(--ok);color:#fff}
[data-theme=dark] .obj.done{background:#14532d;color:#bbf7d0}
details{background:var(--bg);border-radius:10px;padding:8px 12px;margin:8px 0;font-size:22pt}summary{cursor:pointer;font-weight:600}
details code,p code,li code{background:var(--soft);padding:1px 5px;border-radius:5px;font-family:Consolas,monospace;font-size:22pt}
.chk{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:10px;border:1px solid var(--line);margin:6px 0;cursor:pointer;line-height:1.4}
.chk input{margin-top:3px;width:17px;height:17px;flex-shrink:0}
.chk.ok{border-color:var(--ok);background:#dcfce7;color:#166534}.chk.bad{border-color:var(--bad);background:#ffe4e6;color:#9f1239}.chk.miss{border-color:var(--ok);border-style:dashed}
.case{border:1px solid var(--line);border-radius:16px;padding:16px 18px;margin:14px 0;background:var(--bg)}
.case h3{margin-top:0;display:flex;gap:10px;align-items:center}.case h3 span{width:28px;height:28px;border-radius:8px;background:var(--acc);color:#fff;display:grid;place-items:center;font-size:22pt}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}
.opt{border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:9px 12px;border-radius:10px;cursor:pointer;font:inherit;font-size:22pt;text-align:left}
.opt:hover:not(:disabled){border-color:var(--acc)}.opt.on{background:var(--acc);color:#fff;border-color:var(--acc)}
.opt.ok{background:var(--ok)!important;color:#fff;border-color:var(--ok)}.opt.bad{background:var(--bad)!important;color:#fff;border-color:var(--bad)}.opt.miss{border:2px dashed var(--ok)}
.fb{font-size:22pt;margin-top:8px;padding:10px 12px;border-radius:10px;background:var(--soft2);line-height:1.5}
.q{border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin:12px 0}
.q p{font-weight:600}
.score-big{font-size:44pt;font-weight:800;line-height:1}
.grade{width:110px;height:110px;border-radius:24px;display:grid;place-items:center;font-size:44pt;font-weight:800;color:#fff}
.rt td,.rt th{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left}.rt th{background:var(--soft)}
.bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;min-width:100px}.bar i{display:block;height:100%;background:var(--acc2)}
.modal{position:fixed;inset:0;background:rgba(10,15,30,.5);display:none;place-items:center;z-index:50;padding:16px}
.modal.on{display:grid}.modal .card{max-width:480px;text-align:center}
.intro-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:24px;align-items:start}
.form{display:grid;gap:10px;background:var(--bg);border-radius:16px;padding:18px}
.form label{font-size:22pt;color:var(--muted);font-weight:600}
@media(max-width:900px){.wrap{grid-template-columns:1fr;grid-template-rows:auto 1fr}aside{display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding:8px}.st{min-width:190px;margin:0 4px 0 0}.plan,.who{display:none}.grid2,.intro-grid,.opts{grid-template-columns:1fr}.card{padding:18px 14px}h1{font-size:26pt}.cell{height:38px;font-size:22pt}.brand span{display:none}}
@media print{header,aside,.noprint,.row{display:none!important}.wrap{display:block}main{overflow:visible}body{overflow:visible;display:block}.card{box-shadow:none;border:0}}

/* ===== крупный шрифт: не менее 22 pt ===== */
body{font-size:22pt}
header{height:auto;min-height:80px;padding:10px 20px;flex-wrap:wrap}
.logo{width:52px;height:52px}
.wrap{grid-template-columns:1fr;grid-template-rows:auto 1fr}
aside{display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding:10px}
.st{flex:0 0 400px;min-width:0;margin:0 6px 0 0}.st div{min-width:0}
.gantt,.axis,.cnts{clear:both}.st .n{width:48px;height:48px}
.plan{display:none}
.card{max-width:1500px;padding:30px 36px}
h1{font-size:34pt}h2{font-size:28pt;margin:14px 0 12px}h3{font-size:26pt}
.btn{padding:14px 24px}
input[type=text],input[type=number],select{padding:12px 14px;font-size:22pt}
input[type=text][data-n]{width:180px!important}
ul.l li{padding-left:30px}ul.l li:before{width:12px;height:12px;top:.55em}
.intro-grid,.grid2{grid-template-columns:1fr}
.cls tr:first-child{display:none}
.cls tr{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}
.cls td{border:0;padding:0}.cls td:first-child{flex-basis:100%}
.cls tr.expl{padding:0;border:0}.cls tr.expl td{padding:12px 16px;border-radius:12px}
.os svg{width:56px;height:56px}
.seg button{padding:10px 16px}
.brush{width:72px;height:64px}
.cell{height:72px}
.term{height:620px;padding:18px}
.term .il{flex-wrap:wrap}
.obj i{width:36px;height:36px}
.chk input{width:28px;height:28px;margin-top:6px}
.opts{grid-template-columns:1fr 1fr}
.case h3 span{width:44px;height:44px}
.score-big{font-size:60pt}.grade{width:150px;height:150px;font-size:60pt}
.modal .card{max-width:760px}
.ptable td,.ptable th{padding:12px 16px}
@media(max-width:900px){.opts{grid-template-columns:1fr}.st{min-width:280px}h1{font-size:30pt}}

/* ===== BIOS / UEFI эмуляторы ===== */
ol.tl{margin:8px 0 8px 1.4em;line-height:1.5}ol.tl li{margin:6px 0}
.beepvis{font-size:26pt;letter-spacing:4px;color:var(--acc)}
.postmsg{background:#000;color:#e5e7eb;font-family:Consolas,monospace;font-size:22pt;padding:14px 16px;border-radius:10px;white-space:pre-wrap;margin-bottom:12px}
#bwrap,#uwrap{outline:none;border-radius:12px;margin:14px 0}
#bwrap:focus .bios,#bwrap:focus .post{box-shadow:0 0 0 5px #f59e0b}
.bios{background:#b5b9c2;color:#1e3a8a;font-family:Consolas,"Lucida Console","Courier New",monospace;font-size:22pt;border-radius:8px;overflow:hidden;position:relative;user-select:none;border:4px solid #1f2636}
.bios .bt{background:#1e3a8a;color:#fff;text-align:center;padding:6px}
.bios .btabs{background:#1e3a8a;display:flex;flex-wrap:wrap;gap:4px;padding:0 10px}
.bios .btabs span{color:#fff;padding:2px 14px}.bios .btabs span.on{background:#b5b9c2;color:#1e3a8a}
.bios .bbody{display:flex;min-height:620px}
.bios .bleft{flex:2.2;padding:10px 6px;border-right:3px solid #1e3a8a;min-width:0}
.bios .bright{flex:1;padding:12px 16px;color:#1e293b;line-height:1.35;min-width:0}
.bios .row{display:flex;justify-content:space-between;gap:16px;padding:1px 10px;margin:0}
.bios .row .v{white-space:nowrap;color:#0f172a}
.bios .row.ro,.bios .row.ro .v{color:#475569}
.bios .row.h{font-weight:700}
.bios .row.sel{background:#1e3a8a;color:#fff}.bios .row.sel .v{color:#fff}
.bios .bkeys{background:#1e3a8a;color:#fff;padding:8px 12px;line-height:1.35}
.bios .bpop{position:absolute;inset:0;display:grid;place-items:center;background:rgba(15,23,42,.35)}
.bios .bpop .box{background:#1e3a8a;color:#fff;border:4px double #fff;min-width:520px;max-width:92%;padding-bottom:8px}
.bios .bpop .ttl{background:#b5b9c2;color:#1e3a8a;text-align:center;padding:4px 12px;margin-bottom:6px}
.bios .bpop .it{padding:3px 18px}.bios .bpop .it.on{background:#b5b9c2;color:#1e3a8a}
.bios .bpop .yn{display:flex;gap:30px;justify-content:center;padding:8px}.bios .bpop .yn span{padding:0 14px}.bios .bpop .yn span.on{background:#b5b9c2;color:#1e3a8a}
.bios .bpop input{background:#0f172a;color:#fff;border:2px solid #fff;font:inherit;padding:4px 10px;width:100%;outline:none}
.post{background:#000;color:#d1d5db;font-family:Consolas,monospace;font-size:22pt;min-height:640px;padding:24px;line-height:1.5;border-radius:8px;border:4px solid #1f2636}
.post>div{opacity:0;animation:pin .2s forwards}@keyframes pin{to{opacity:1}}
.post .er{color:#f87171}.post .ok{color:#4ade80}.post .dim{color:#9ca3af}.post .pk{color:#fde047;margin-top:20px}
.vkeys{display:flex;flex-wrap:wrap;gap:8px}.vkeys .btn{padding:10px 16px;min-width:72px}
.uefi{background:#0b1220;color:#e2e8f0;border-radius:14px;overflow:hidden;position:relative;font-size:22pt;border:3px solid #1e293b;min-height:640px;user-select:none}
.u-top{display:flex;align-items:center;gap:16px;padding:10px 18px;background:#111c33;flex-wrap:wrap}
.u-top .sp{flex:1}.u-mode{background:#0284c7;color:#fff;border-radius:8px;padding:2px 12px}
.u-tabs{display:flex;flex-wrap:wrap;gap:4px;padding:8px 12px;background:#0f1a30;border-bottom:1px solid #1e293b}
.u-tabs button{background:none;border:0;color:#94a3b8;font:inherit;padding:6px 14px;border-radius:8px;cursor:pointer}
.u-tabs button.on{background:#0284c7;color:#fff}.u-tabs button:hover{color:#fff}
.u-body{display:grid;grid-template-columns:1fr 380px;min-height:520px}
.u-list{padding:12px 16px;min-width:0}
.u-crumb{color:#38bdf8;cursor:pointer;margin-bottom:8px}
.u-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 14px;border-radius:10px;cursor:pointer;margin:5px 0;background:#121d36;flex-wrap:wrap}
.u-row:hover{background:#1b2a4d}.u-row.ro{cursor:default;background:none;padding:4px 14px}.u-row.ro:hover{background:none}
.u-row.h{background:none;color:#38bdf8;font-weight:700;cursor:default;padding:6px 14px 0}
.u-row.dis{opacity:.4;cursor:not-allowed}
.u-row .v{background:#0b1220;border:1px solid #334155;border-radius:8px;padding:2px 12px;color:#38bdf8}
.u-row.ro .v{border:0;background:none;color:#cbd5e1}
.u-side{background:#0f1a30;padding:14px 16px;border-left:1px solid #1e293b}
.u-side h4,.tile h4,.u-dlg h4{color:#38bdf8;margin-bottom:8px;font-size:22pt}
.u-help{color:#cbd5e1;line-height:1.4}.u-hw{color:#e2e8f0;line-height:1.5}
.u-bot{display:flex;gap:10px;flex-wrap:wrap;padding:10px 14px;background:#111c33;justify-content:flex-end}
.u-btn{background:#1e293b;color:#e2e8f0;border:1px solid #334155;border-radius:10px;padding:8px 16px;font:inherit;cursor:pointer}
.u-btn:hover{border-color:#38bdf8}.u-btn.pri{background:#f59e0b;color:#111;border-color:#f59e0b}
.u-pop{position:absolute;inset:0;background:rgba(2,6,23,.7);display:grid;place-items:center;z-index:5;padding:16px}
.u-dlg{background:#111c33;border:2px solid #38bdf8;border-radius:14px;padding:18px;min-width:min(620px,95%);max-width:95%;max-height:92%;overflow:auto}
.u-opt{display:block;width:100%;text-align:left;background:#16213b;color:#e2e8f0;border:1px solid #334155;border-radius:10px;padding:8px 14px;margin:6px 0;font:inherit;cursor:pointer}
.u-opt:hover{border-color:#38bdf8}.u-opt.on{background:#0284c7;border-color:#0284c7}
.u-ez{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;padding:16px}
.tile{background:#16213b;border-radius:14px;padding:14px 16px;line-height:1.45}.tile.wide{grid-column:1/-1}
.u-brow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid #1e293b;flex-wrap:wrap}
.u-mini{background:#1e293b;color:#e2e8f0;border:1px solid #334155;border-radius:8px;padding:2px 12px;margin-left:6px;font:inherit;cursor:pointer}
.u-boot{min-height:640px;display:grid;place-content:center;gap:20px;text-align:center}
