 const c=$('#chk2');if(c)c.onclick=()=>{const un=JSON.stringify(B.cfg)!==JSON.stringify(B.saved);if(!confirm((un?'В эмуляторе есть НЕСОХРАНЁННЫЕ изменения — они не будут учтены.\n':'')+'Сдать этап 2? Оценивается сохранённая конфигурация.'))return;S.s2d=true;render()};
 if(!S.s2d)setTimeout(()=>w.focus({preventScroll:true}),50)};

