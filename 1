 const inp=$('#binp');if(!inp&&(document.activeElement===document.body||!document.activeElement))w.focus({preventScroll:true});if(inp){inp.focus({preventScroll:true});inp.select();inp.onkeydown=e=>{e.stopPropagation();if(e.key==='Enter'){e.preventDefault();const p=B.pop;B.pop=null;p.ok(inp.value);brender()}else if(e.key==='Escape'){e.preventDefault();B.pop=null;brender();$('#bwrap').focus()}}}
