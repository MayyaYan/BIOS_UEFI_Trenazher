 case 3:return [{t:'ro',l:'Administrator Password',v:c.apwd?'Installed':'Not Installed'},{t:'ro',l:'User Password',v:c.upwd?'Installed':'Not Installed'},{t:'sp'},{t:'pwd',k:'apwd',l:'Administrator Password',h:'Пароль на вход в Setup. Enter — установить/изменить. Пустой новый пароль удаляет его.'},{t:'pwd',k:'upwd',l:'User Password',h:'Пароль пользователя.'},{t:'opt',k:'pchk',l:'Password Check',o:['Setup','Always'],h:'Setup — пароль только при входе в Setup; Always — и при каждой загрузке.'}];
 case 4:return [{t:'act',a:'save',l:'Save Changes and Reset',h:'Сохранить изменения и перезагрузить (F10).'},{t:'act',a:'discard',l:'Discard Changes and Exit',h:'Выйти без сохранения.'},{t:'act',a:'savenr',l:'Save Changes',h:'Сохранить без перезагрузки.'},{t:'act',a:'defaults',l:'Restore Defaults',h:'Загрузить оптимальные значения по умолчанию (F9).'},{t:'sp'},{t:'h',l:'Boot Override'},...bEff(c).map(d=>({t:'act',a:'ovr:'+d,l:BDEV[d],h:'Однократная загрузка с этого устройства без сохранения.'}))];}}
const BTABS=['Main','Advanced','Boot','Security','Save & Exit'];
const bItems=()=>B.sub?BSUB[B.sub].it:bTab(B.tab);
const bSel=it=>['opt','sub','date','time','pwd','boot','act'].includes(it.t);
