<p id="bst" style="color:var(--muted)"></p>
<h2>Вопросы по данным BIOS (по 2 балла)</h2>
${B_Q.map(q=>{const v=S.s2q[q[0]]??'';const st=S.s2d?(near(v,q[2],q[3])?'okf':'badf'):'';return `<div class="q"><p>${q[1]}</p><input type="text" data-q2="${q[0]}" value="${esc(v)}" class="${st}" style="width:260px">${S.s2d&&!near(v,q[2],q[3])?` <span style="color:var(--ok)">верно: ${q[2]}</span>`:''}</div>`}).join('')}
${S.s2d?`<h2>Проверка сохранённой конфигурации</h2><table class="rt">${B_ITEMS.map(x=>`<tr><td>${x[1](B.saved)?'✅':'❌'}</td><td>${x[0]}</td><td>${x[1](B.saved)?'1,5':'0'}</td></tr>`).join('')}<tr><td>${B_CLEAN.every(k=>B.saved[k]===BDEF[k])?'✅':'❌'}</td><td>Лишние параметры не изменены</td><td>${B_CLEAN.every(k=>B.saved[k]===BDEF[k])?'1':'0'}</td></tr></table>`:''}
<div class="row">${S.s2d?`${resTag(sc2(),25)}Этап 2: ${sc2()} / 25</span>`:`<button class="btn" id="chk2">Сдать этап 2</button>`}${nextBtn('s2')}</div></div>`;
BIND.s2=()=>{const w=$('#bwrap');brender();w.onkeydown=bKey;w.onclick=()=>{if(!$('#binp'))w.focus()};
 main.querySelectorAll('[data-vk]').forEach(b=>b.onclick=()=>{const m={'↑':'ArrowUp','↓':'ArrowDown','←':'ArrowLeft','→':'ArrowRight','Del':'Delete','−':'-'};const k=m[b.dataset.vk]||b.dataset.vk;const inp=$('#binp');if(inp&&(k==='Enter'||k==='Escape')){inp.dispatchEvent(new KeyboardEvent('keydown',{key:k}));return}bKey({key:k});w.focus()});
 $('#clrcmos').onclick=()=>{if(!confirm('Выполнить сброс CMOS? Все настройки, дата, время и пароли вернутся к заводским.'))return;B.cfg=clone(BDEF);B.saved=clone(BDEF);B.screen='setup';B.pop=null;B.tab=0;B.sub=null;bFirst();brender()};
