 if(it.t==='date')bPop({type:'input',title:'System Date (MM/DD/YYYY)',value:c.date,ok:v=>{const m=v.trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(!m||+m[1]<1||+m[1]>12||+m[2]<1||+m[2]>31){bMsg('Error','Invalid date. Формат: ММ/ДД/ГГГГ');return}const d=`${m[1].padStart(2,'0')}/${m[2].padStart(2,'0')}/${m[3]}`;c.date=d;B.saved.date=d}});
 if(it.t==='time')bPop({type:'input',title:'System Time (HH:MM:SS)',value:c.time,ok:v=>{const m=v.trim().match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);if(!m||+m[1]>23||+m[2]>59||(m[3]&&+m[3]>59)){bMsg('Error','Invalid time. Формат: ЧЧ:ММ:СС');return}const t=`${m[1].padStart(2,'0')}:${m[2]}:${m[3]||'00'}`;c.time=t;B.saved.time=t}});
 if(it.t==='pwd'){const k=it.k;const setNew=()=>bPop({type:'input',title:'Create New Password',mask:true,hint:'Пустое значение — удалить пароль',ok:v1=>{if(!v1){c[k]='';bMsg('Password','Пароль удалён.');return}bPop({type:'input',title:'Confirm New Password',mask:true,ok:v2=>{if(v1!==v2){bMsg('Warning','Passwords do not match! Пароли не совпадают.')}else{c[k]=v1;bMsg('Password','Пароль установлен (будет действовать после сохранения).')}}})}});
