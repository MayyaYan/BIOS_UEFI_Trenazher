function brender(){const w=$('#bwrap');if(!w)return;
 if(B.screen==='post'){w.innerHTML=`<div class="post">${B.post.map((l,i)=>`<div style="animation-delay:${i*.18}s" class="${l[1]||''}">${esc(l[0])}</div>`).join('')}<div style="animation-delay:${B.post.length*.18+.3}s" class="pk">Нажмите <b>Del</b>, чтобы войти в BIOS Setup</div></div>`;return}
 if(B.screen==='halt'){w.innerHTML=`<div class="post"><div class="er">Неверный пароль введён 3 раза.</div><div class="er">System Halted!</div><div class="pk">Выполните сброс CMOS (кнопка под эмулятором).</div></div>`;return}
 const it=bItems();
 const rows=it.map((x,i)=>x.t==='sp'?'<div class="row">&nbsp;</div>':x.t==='h'?`<div class="row h">${esc(x.l)}</div>`:`<div class="row ${bSel(x)?'':'ro'}${i===B.cur&&B.screen==='setup'?' sel':''}"><span>${x.t==='sub'?'▶ ':''}${esc(x.l)}</span><span class="v">${esc(bVal(x))}</span></div>`).join('');
 const cur=it[B.cur]||{};
 let pop='';if(B.pop){const p=B.pop;
